<!--
  Elvis gold aviator sunglasses art — original, authored in this repo, Apache 2.0.

  The 420x176 viewport gives a 0.419 aspect and MUST stay in sync with Lens.Elvis's artAspect
  for the shades layer. Slightly wider than Sunglasses (400x144) for the aviator overhang.

  TEARDROP aviator shape: narrower at the top (bridge), wider and more rounded at the bottom
  (cheeks). Thin METAL FRAMES in gold (#C9A227 range, not yellow), DOUBLE BRIDGE, dark smoked
  lenses with radial gradients + specular streaks. Quality bar is Snapchat AR, not a yellow UI pill.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/apk/res-auto"
    android:width="210dp"
    android:height="88dp"
    android:viewportWidth="420"
    android:viewportHeight="176">

  <!-- Bayonet temples (arms), drawn first so frames sit over them. Metallic gold. -->
  <path
      android:fillColor="#FFC9A227"
      android:pathData="M0,80 L26,80 L26,88 L0,88 Z
                        M394,80 L420,80 L420,88 L394,88 Z" />

  <!-- Double bridge — the defining aviator feature. Two thin bars. -->
  <path
      android:fillColor="#FFC9A227"
      android:pathData="M184,62 L194,62 L194,68 L184,68 Z
                        M226,62 L236,62 L236,68 L226,68 Z" />
  <!-- Bridge connector. -->
  <path
      android:fillColor="#FFC9A227"
      android:pathData="M192,58 L228,58 L228,72 L192,72 Z" />

  <!-- LEFT FRAME outer — thin metal rim, teardrop shape. -->
  <path
      android:pathData="M52,28
                        L164,28
                        A30,30 0 0 1 194,58
                        L194,96
                        A40,40 0 0 1 154,136
                        L62,136
                        A40,40 0 0 1 22,96
                        L22,58
                        A30,30 0 0 1 52,28 Z
                        M56,34
                        L160,34
                        A26,26 0 0 1 186,60
                        L186,94
                        A36,36 0 0 1 150,130
                        L66,130
                        A36,36 0 0 1 30,94
                        L30,60
                        A26,26 0 0 1 56,34 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="108"
          android:startY="28"
          android:endX="108"
          android:endY="136"
          android:startColor="#FFD4B236"
          android:endColor="#FFAA8520" />
    </aapt:attr>
  </path>

  <!-- RIGHT FRAME outer — thin metal rim, teardrop shape. -->
  <path
      android:pathData="M256,28
                        L368,28
                        A30,30 0 0 1 398,58
                        L398,96
                        A40,40 0 0 1 358,136
                        L266,136
                        A40,40 0 0 1 226,96
                        L226,58
                        A30,30 0 0 1 256,28 Z
                        M260,34
                        L364,34
                        A26,26 0 0 1 390,60
                        L390,94
                        A36,36 0 0 1 354,130
                        L270,130
                        A36,36 0 0 1 234,94
                        L234,60
                        A26,26 0 0 1 260,34 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="312"
          android:startY="28"
          android:endX="312"
          android:endY="136"
          android:startColor="#FFD4B236"
          android:endColor="#FFAA8520" />
    </aapt:attr>
  </path>

  <!-- LEFT LENS — dark smoked glass with radial gradient for depth. -->
  <path
      android:pathData="M56,38
                        L160,38
                        A24,24 0 0 1 184,62
                        L184,92
                        A34,34 0 0 1 150,126
                        L70,126
                        A34,34 0 0 1 36,92
                        L36,62
                        A24,24 0 0 1 56,38 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="radial"
          android:centerX="100"
          android:centerY="70"
          android:gradientRadius="76">
        <item android:offset="0.0" android:color="#FF28282D" />
        <item android:offset="0.65" android:color="#FF18181C" />
        <item android:offset="1.0" android:color="#FF0A0A0C" />
      </gradient>
    </aapt:attr>
  </path>

  <!-- RIGHT LENS — dark smoked glass with radial gradient for depth. -->
  <path
      android:pathData="M260,38
                        L364,38
                        A24,24 0 0 1 388,62
                        L388,92
                        A34,34 0 0 1 354,126
                        L274,126
                        A34,34 0 0 1 240,92
                        L240,62
                        A24,24 0 0 1 260,38 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="radial"
          android:centerX="320"
          android:centerY="70"
          android:gradientRadius="76">
        <item android:offset="0.0" android:color="#FF28282D" />
        <item android:offset="0.65" android:color="#FF18181C" />
        <item android:offset="1.0" android:color="#FF0A0A0C" />
      </gradient>
    </aapt:attr>
  </path>

  <!-- Specular highlight streaks — kept inside the lens contours. Diagonal light reflection. -->
  <path
      android:fillAlpha="0.35"
      android:fillColor="#FFFFFFFF"
      android:pathData="M60,115 L108,50 L128,50 L80,115 Z
                        M264,115 L312,50 L332,50 L284,115 Z" />

  <!-- Frame highlight for metallic sheen. -->
  <path
      android:fillAlpha="0.28"
      android:fillColor="#FFFEF8E4"
      android:pathData="M52,30 L164,30 A28,28 0 0 1 192,58 L192,60 A28,28 0 0 0 164,32 L52,32 A28,28 0 0 0 24,60 L24,58 A28,28 0 0 1 52,30 Z
                        M256,30 L368,30 A28,28 0 0 1 396,58 L396,60 A28,28 0 0 0 368,32 L256,32 A28,28 0 0 0 228,60 L228,58 A28,28 0 0 1 256,30 Z" />
