<!--
  Elvis pompadour/quiff art — original, authored in this repo, Apache 2.0.

  The 280x180 viewport gives a 0.643 aspect and MUST stay in sync with Lens.Elvis's artAspect.
  OPEN BOTTOM sitting on the hairline/forehead (viewport bottom), high swept-back volume above
  the crown (viewport top). Dark hair with highlights, flow lines, and depth — not a helmet.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/apk/res-auto"
    android:width="140dp"
    android:height="90dp"
    android:viewportWidth="280"
    android:viewportHeight="180">

  <!-- Base hair volume — dark with warm brown undertones, open at bottom. -->
  <path
      android:pathData="M35,180
                        L35,115
                        Q35,80 48,52
                        Q61,24 85,12
                        Q109,0 140,0
                        Q171,0 195,12
                        Q219,24 232,52
                        Q245,80 245,115
                        L245,180
                        Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="140"
          android:startY="0"
          android:endX="140"
          android:endY="180"
          android:startColor="#FF1C1815"
          android:endColor="#FF0E0D0B" />
    </aapt:attr>
  </path>

  <!-- Inner shadow for depth — cooler, darker toward the back sweep. -->
  <path
      android:fillAlpha="0.45"
      android:fillColor="#FF080705"
      android:pathData="M55,180
                        L55,125
                        Q55,90 68,62
                        Q81,34 105,22
                        Q115,18 125,16
                        Q112,20 100,28
                        Q75,48 65,85
                        Q60,110 60,145
                        L60,180
                        Z" />

  <!-- Front wave/roll — the iconic pompadour curl, swept back from the forehead. -->
  <path
      android:fillColor="#FF25211D"
      android:pathData="M80,180
                        L80,130
                        Q80,100 95,78
                        Q110,56 132,48
                        Q154,56 169,78
                        Q184,100 184,130
                        L184,180
                        Z" />

  <!-- Top highlight — glossy sheen along the high curve. -->
  <path
      android:fillAlpha="0.32"
      android:pathData="M100,52
                        Q115,40 132,36
                        Q149,40 164,52
                        Q170,62 173,75
                        Q160,68 147,66
                        Q134,68 121,75
                        Q107,62 100,52 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="132"
          android:startY="36"
          android:endX="132"
          android:endY="85"
          android:startColor="#FFFFFFFF"
          android:endColor="#00FFFFFF" />
    </aapt:attr>
  </path>

  <!-- Side contour highlights — catches light on the rounded volume. -->
  <path
      android:fillAlpha="0.18"
      android:fillColor="#FFFFFFFF"
      android:pathData="M45,130 Q48,95 58,65 Q68,35 88,18 L85,20 Q66,38 56,68 Q48,98 46,135 Z
                        M235,130 Q232,95 222,65 Q212,35 192,18 L195,20 Q214,38 224,68 Q232,98 234,135 Z" />

  <!-- Flow/texture lines — directional strokes suggesting hair swept back. -->
  <path
      android:fillAlpha="0.12"
      android:fillColor="#FF000000"
      android:pathData="M95,165 Q105,135 118,110 Q120,115 108,145 Q100,165 95,180 Z
                        M125,170 Q132,140 142,115 Q144,120 134,150 Q128,172 125,180 Z
                        M155,170 Q148,140 138,115 Q136,120 146,150 Q152,172 155,180 Z
                        M185,165 Q175,135 162,110 Q160,115 172,145 Q180,165 185,180 Z" />

  <!-- Lower edge contour — root of the quiff on the hairline. -->
  <path
      android:fillAlpha="0.25"
      android:fillColor="#FF000000"
      android:pathData="M40,175 Q70,170 100,168 Q130,166 160,168 Q190,170 220,173 Q240,175 245,180 L35,180 Q37,176 40,175 Z" />
</vector>
